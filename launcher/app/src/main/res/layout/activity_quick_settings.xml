<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/scrimBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000"
        android:importantForAccessibility="no" />

    <!-- Compact Apple TV-style Quick Settings Floating Panel -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="316dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/quick_panel_frosted_bg"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="0dp"
        android:focusable="false"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutMainPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:orientation="vertical">

            <!-- Header: Date, Clock & Always-Reachable All Settings -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@id/btnAllSettings"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quickDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.06"
                        android:singleLine="true"
                        android:textAllCaps="true"
                        android:textColor="#FFA8C7FA"
                        android:textSize="10.5sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <com.gathin.tvhome.LiveClockView
                            android:id="@+id/quickClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/font_body"
                            android:singleLine="true"
                            android:textColor="#FFF4F5F8"
                            android:textSize="28sp" />

                        <TextClock
                            android:id="@+id/quickAmPm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="3dp"
                            android:fontFamily="@string/font_medium"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="#FFC4C6D0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAllSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnAllSettingsCircle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/quick_tile_frosted_bg"
                        android:duplicateParentState="true">

                        <ImageView
                            android:id="@+id/btnAllSettingsIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/quick_tile_icon_color" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnAllSettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@string/font_body"
                        android:singleLine="true"
                        android:text="@string/all_settings"
                        android:textColor="#FFD8DAE2"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Independent Quick Settings Media Now Playing Bar -->
            <LinearLayout
                android:id="@+id/quickMediaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/quick_tile_frosted_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    android:tint="#FFA8C7FA" />

                <LinearLayout
                    android:id="@+id/quickMediaOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quickMediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@string/font_medium"
                        android:singleLine="true"
                        android:textColor="@color/quick_tile_text_color"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/quickMediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@string/font_body"
                        android:singleLine="true"
                        android:textColor="@color/quick_tile_sub_color"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quickMediaPlayPause"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/quick_tile_frosted_bg"
                    android:clickable="true"
                    android:contentDescription="@string/media_play_pause"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏯"
                    android:textColor="@color/quick_tile_text_color"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/quickMediaNext"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/quick_tile_frosted_bg"
                    android:clickable="true"
                    android:contentDescription="@string/media_next"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏭"
                    android:textColor="@color/quick_tile_text_color"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Scrollable Controls Container (Reflowed 2-Column Tiles or Edit Controls Checklist) -->
            <ScrollView
                android:id="@+id/quickScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/quickTilesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp" />
            </ScrollView>

            <!-- Always-Reachable Footer Action (Edit Controls / Done) + Back Hint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnEditControls"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/appletv_row_frosted"
                    android:clickable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/btnEditControlsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@string/font_medium"
                        android:singleLine="true"
                        android:text="@string/qs_edit_controls"
                        android:textColor="@color/appletv_row_title_color"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quickFooterHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@string/font_body"
                    android:text="@string/quick_settings_footer"
                    android:textColor="#FF7E8494"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
