<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock, date, and full month calendar that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The glow is its background; clock_wallpaper puts the picture in it, cropped like Home's. -->
    <ImageView
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/dreamClockGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextClock
                    android:id="@+id/dreamClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#E6FFFFFF"
                    android:textSize="110sp"
                    android:fontFamily="@string/font_extralight"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/dreamSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp"
                    android:format12Hour=":ss"
                    android:format24Hour=":ss"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#B3FFFFFF"
                    android:textSize="36sp"
                    android:fontFamily="@string/font_light"
                    android:letterSpacing="0.02"
                    android:includeFontPadding="false" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="#99FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#8CFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />
        </LinearLayout>

        <View
            android:id="@+id/dreamCalendarDivider"
            android:layout_width="1dp"
            android:layout_height="160dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="#26FFFFFF" />

        <com.gathin.tvhome.MonthCalendarView
            android:id="@+id/dreamCalendar"
            android:layout_width="280dp"
            android:layout_height="210dp" />

    </LinearLayout>
</FrameLayout>
