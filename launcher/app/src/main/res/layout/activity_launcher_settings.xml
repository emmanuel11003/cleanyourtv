                android:text="@string/switch_off_badge"
                android:textColor="#FFC4C6D0"
                android:background="@drawable/switch_off_bg"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Built-in Wi-Fi Wallpaper & Backup Sync Row -->
        <LinearLayout
            android:id="@+id/wifiSyncRow"
            style="@style/SettingsRow"
            android:layout_marginTop="24dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_sync"
                android:tint="#FFA8C7FA"
                android:duplicateParentState="true"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:duplicateParentState="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper_sync_title"
                    android:textColor="#FFE3E2E6"
                    android:textSize="18sp"
                    android:duplicateParentState="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/wallpaper_sync_subtitle"
                    android:textColor="#FFC4C6D0"
                    android:textSize="13sp"
                    android:duplicateParentState="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden Apps Manager Row -->
        <LinearLayout
            android:id="@+id/hiddenAppsRow"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hidden_apps_label"
                android:textColor="#FFE3E2E6"
                android:textSize="18sp"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/hiddenAppsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/hidden_apps_summary"
                android:textColor="#FFC4C6D0"
                android:textSize="13sp"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Backup & Restore Settings Row -->
        <LinearLayout
            android:id="@+id/backupRow"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_label"
                android:textColor="#FFE3E2E6"
                android:textSize="18sp"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/backup_summary"
                android:textColor="#FFC4C6D0"
                android:textSize="13sp"
                android:duplicateParentState="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFC4C6D0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFC4C6D0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
