                android:minWidth="64dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="14sp"
                android:fontFamily="@string/font_regular"
                android:text="@string/switch_on_badge"
                android:textColor="#FFE3E2E6"
                android:background="@drawable/switch_on_bg"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Top Bar Stats Switch Row -->
        <LinearLayout
            android:id="@+id/statsRow"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:duplicateParentState="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_label"
                    android:textColor="#FFE3E2E6"
                    android:textSize="18sp"
                    android:duplicateParentState="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/stats_summary"
                    android:textColor="#FFC4C6D0"
                    android:textSize="13sp"
                    android:duplicateParentState="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/statsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="14sp"
                android:fontFamily="@string/font_regular"
                android:text="@string/switch_on_badge"
                android:textColor="#FFE3E2E6"
                android:background="@drawable/switch_on_bg"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Inputs Pill Switch Row -->
        <LinearLayout
            android:id="@+id/inputsPillRow"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:duplicateParentState="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inputs_pill_label"
                    android:textColor="#FFE3E2E6"
                    android:textSize="18sp"
                    android:duplicateParentState="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/inputs_pill_summary"
                    android:textColor="#FFC4C6D0"
                    android:textSize="13sp"
                    android:duplicateParentState="true" />
