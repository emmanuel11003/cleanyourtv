<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/appletv_screen_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- Left half: CleanYourTV hardware showcase on Root, contextual icon/summary on Submenus,
             and wallpaper preview strictly when inside Wallpaper pickers. -->
        <FrameLayout
            android:id="@+id/leftPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.46"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingEnd="24dp">

            <com.gathin.tvhome.DeviceHeroView
                android:id="@+id/deviceHero"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/submenuHeroBox"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/heroIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="18dp"
                    android:contentDescription="@null"
                    android:tint="#FFD4D8E2" />

                <TextView
                    android:id="@+id/heroHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="#FFF4F5F8"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/heroSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="#FFA4AAB8"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wallpaperPreviewBox"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/wallpaperPreviewFrame"
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:background="#FF1A1C24">

                    <ImageView
                        android:id="@+id/wallpaperPreviewImg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <TextView
                    android:id="@+id/wallpaperPreviewCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="#FFA4AAB8"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right half: Header + compact smoked-glass vertical menu list -->
        <LinearLayout
            android:id="@+id/rightPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.54"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="30dp"
            android:paddingEnd="56dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/settingsBreadcrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:ellipsize="start"
                android:singleLine="true"
                android:textColor="#FF8D93A3"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="@string/settings_root_title"
                android:textColor="#FFF5F6FA"
                android:textSize="32sp" />

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
