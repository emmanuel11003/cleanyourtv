<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2D3342" />
            <stroke android:width="2dp" android:color="#FFA8C7FA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF004A77" />
            <stroke android:width="1.5dp" android:color="#FFA8C7FA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2028" />
            <stroke android:width="1dp" android:color="#FF2E313B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
